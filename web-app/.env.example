# Copy to .env.local and fill in after deploying (see ../DEPLOY.md).
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_TOKEN_CONTRACT=cto.you.testnet
NEXT_PUBLIC_NFT_CONTRACT=ctoads.you.testnet
# Optional: RPCs to try first, separated by commas. FastNEAR, dRPC and Intear follow as fallbacks.
# NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com

# Alerts (server only, never NEXT_PUBLIC_): the Supabase project that stores subscribers.
# From the project's API settings. The service role key bypasses row level security, so keep it secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Sending alerts by text, through msgbubbles (docs.msgbubbles.com). The number is one of your
# msgbubbles numbers and is shown on the Alerts page. The API key is server only.
NEXT_PUBLIC_MSGBUBBLES_NUMBER=
MSGBUBBLES_API_KEY=
MSGBUBBLES_WEBHOOK_SECRET=

# Alerts and profiles are checked by a private AI model on NEAR AI Cloud (cloud.near.ai) before
# they're sent or saved. Server only.
NEARAI_API_KEY=

# Images in alerts: an S3 bucket the browser uploads to (it needs a CORS rule allowing PUT from the
# site) and credentials that can put and get objects in it. Server only.
ALERTS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email alerts through Resend (resend.com). The from address must be on a domain verified in
# Resend, e.g. alerts@<your-domain>. Server only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: a NEAR Intents 1Click API key (see docs.near-intents.org) for the "Top up from any
# chain" card. Without one it still works, and 1Click keeps 0.2% of each swap. Server only.
ONECLICK_API_KEY=
